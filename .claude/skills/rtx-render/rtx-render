#!/usr/bin/env python3
"""Render a Blender scene on the rtxserver (RTX 4090) as if it rendered locally.

  rtx-render scene.blend [-o OUT] [-s START] [-e END] [-w WORKERS] [--mp4] [--video-only] [--detach]
  rtx-render build.py [--base base.blend] [...same options]
  rtx-render monitor [JOB]        live progress, keeps syncing frames into the job's out folder
  rtx-render status               every job: frames done / total
  rtx-render cancel [JOB]         stop a job's workers on the server
  rtx-render clean [JOB]          delete a finished job's files on the server
  rtx-render clean --cache        drop the server's cached scene uploads

A .blend is packed (textures, fonts, libraries) into one file before upload. Uploads are diffs: the
server keeps the last upload of each file (keyed by its path inside the git repo, so collaborators share
it) and rsync sends only what changed. The host is rtxserver on the campus network, else rtx-remote
(Cloudflare tunnel); RTX_HOST overrides. --video-only encodes the mp4 on the server and downloads only that. A .py is a script that
builds a scene: it runs here, in a local headless Blender (so its local paths all work), and the scene it
leaves behind is packed and rendered remotely. Frames are written as PNGs by the scene's own render
settings and are copied into OUT (default ./out/<name>/) while the job runs. Ctrl-C in the monitor only
detaches; the job keeps running on the server. Several Blender processes share the frames (each claims
the next free frame with a placeholder file), so CPU-side work such as Freestyle overlaps on the server's
32 cores and the GPU stays busy.
"""
import argparse
import hashlib
import json
import os
import shlex
import subprocess
import sys
import tempfile
import time

HOST = None          # resolved in main(): RTX_HOST, else rtxserver on campus, else rtx-remote (Cloudflare tunnel)
REMOTE_BLENDER = "~/blender-install/blender-4.5.6-linux-x64/blender"
REMOTE_ROOT = "~/tmp/rtx-render"
LOCAL_BLENDER = os.environ.get("BLENDER", "blender")
STATE = os.path.expanduser("~/.cache/rtx-render/jobs.json")
SSH_OPTS = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "ControlMaster=auto",
            "-o", "ControlPath=~/.ssh/cm-rtx-render-%r@%h:%p", "-o", "ControlPersist=10m"]

PACK_PY = r"""
import bpy, json, sys
s = bpy.context.scene
out = sys.argv[sys.argv.index("--") + 1]
bpy.ops.file.pack_all()
s.render.filepath = "//frames/f_"
s.render.use_file_extension = True
fmt = s.render.image_settings.file_format
if fmt in ("FFMPEG", "AVI_JPEG", "AVI_RAW"):          # movie outputs become a PNG sequence
    s.render.image_settings.file_format = "PNG"
bpy.ops.wm.save_as_mainfile(filepath=out, compress=False, copy=True)   # uncompressed: rsync can diff it
print("RTX_SCENE " + json.dumps(dict(start=s.frame_start, end=s.frame_end, step=s.frame_step, fps=s.render.fps,
      ext=s.render.file_extension, res=[s.render.resolution_x, s.render.resolution_y, s.render.resolution_percentage],
      engine=s.render.engine)))
"""

# Cycles picks its device from user preferences, which a background run on the server doesn't have.
# Workers share one frame range: each claims a frame with an empty placeholder file and skips frames
# already on disk, so they balance themselves and a rerun in the same job dir resumes.
REMOTE_DEVICE_PY = r"""
import bpy
s = bpy.context.scene
s.render.use_overwrite = False
s.render.use_placeholder = True
if s.render.engine == "CYCLES":
    prefs = bpy.context.preferences.addons["cycles"].preferences
    for kind in ("OPTIX", "CUDA"):
        try:
            prefs.compute_device_type = kind
            break
        except TypeError:
            pass
    prefs.get_devices()
    for d in prefs.devices:
        d.use = d.type != "CPU"
    s.cycles.device = "GPU"
"""


# ------------------------------------------------------------------ plumbing
def resolve_host():
    """The same box two ways: direct on the campus network, or through the Cloudflare tunnel from anywhere."""
    if os.environ.get("RTX_HOST"):
        return os.environ["RTX_HOST"]
    for host in ("rtxserver", "rtx-remote"):
        ok = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", host, "true"],
                            capture_output=True, timeout=40).returncode == 0
        if ok:
            return host
    sys.exit("can't reach the server as rtxserver (campus) or rtx-remote (tunnel); see the skill's access notes")


def ssh(cmd, check=True, capture=True):
    r = subprocess.run(["ssh", *SSH_OPTS, HOST, cmd], capture_output=capture, text=True)
    if check and r.returncode != 0:
        sys.exit(f"ssh {HOST} failed ({r.returncode}): {r.stderr.strip() if capture else ''}")
    return r.stdout if capture else ""


def cache_key(path):
    """Uploads of the same file share a server-side cache, so the next one is sent as a diff. Inside a git
    repo the key is the repo-relative path, so collaborators diff against each other's uploads too."""
    name = os.path.splitext(os.path.basename(path))[0]
    r = subprocess.run(["git", "-C", os.path.dirname(path), "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    ident = os.path.relpath(path, r.stdout.strip()) if r.returncode == 0 else path
    return f"{name}-{hashlib.sha1(ident.encode()).hexdigest()[:8]}"


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(st, f, indent=1)


def pick_job(st, name):
    if not st:
        sys.exit("no jobs yet")
    if name is None:
        return max(st.values(), key=lambda j: j["created"])
    if name not in st:
        sys.exit(f"unknown job {name}; known: {', '.join(st)}")
    return st[name]


def fmt_time(s):
    s = int(max(s, 0))
    return f"{s // 3600}h{s // 60 % 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


# ------------------------------------------------------------------ submit
def prepare(path, base, workdir):
    """Pack the scene into workdir/<name>.blend; returns (packed path, scene info)."""
    name = os.path.splitext(os.path.basename(path))[0]
    packed = os.path.join(workdir, name + ".blend")
    pack = os.path.join(workdir, "pack.py")
    with open(pack, "w") as f:
        f.write(PACK_PY)
    cmd = [LOCAL_BLENDER, "-b"]
    if path.endswith(".blend"):
        cmd += [path]
    else:
        if base:
            cmd += [base]
        cmd += ["-P", os.path.abspath(path)]
    cmd = cmd[:2] + ["--python-exit-code", "1"] + cmd[2:] + ["-P", pack, "--", packed]
    print(f"packing locally: {' '.join(shlex.quote(c) for c in cmd[:4])} ...")
    r = subprocess.run(cmd, capture_output=True, text=True, cwd=os.path.dirname(os.path.abspath(path)))
    info = next((json.loads(l[10:]) for l in r.stdout.splitlines() if l.startswith("RTX_SCENE ")), None)
    if r.returncode != 0 or info is None or not os.path.exists(packed):
        sys.stderr.write(r.stdout[-3000:] + r.stderr[-2000:])
        sys.exit("packing failed")
    return packed, info


def submit(a):
    path = os.path.abspath(a.scene)
    if not os.path.exists(path) or not path.endswith((".blend", ".py")):
        sys.exit("give a .blend or a .py scene script")
    name = os.path.splitext(os.path.basename(path))[0]
    job = f"{name}-{time.strftime('%m%d-%H%M%S')}"
    out = os.path.abspath(a.out or os.path.join("out", name))
    work = tempfile.mkdtemp(prefix="rtx-render-")
    packed, info = prepare(path, a.base, work)
    start = a.start if a.start is not None else info["start"]
    end = a.end if a.end is not None else info["end"]
    step = info["step"] or 1
    frames = list(range(start, end + 1, step))
    size = os.path.getsize(packed) / 1e6
    print(f"scene: {info['engine']}, {info['res'][0]}x{info['res'][1]} @ {info['res'][2]}%, "
          f"frames {start}-{end} ({len(frames)}), packed {size:.0f} MB")

    rdir = f"{REMOTE_ROOT}/{job}"
    free = int(ssh("df -Pk ~ | tail -1 | awk '{print $4}'").strip() or 0) / 1e6
    if free < 2 + size / 1000:
        sys.exit(f"only {free:.1f} GB free on {HOST}; clean up first (rtx-render clean)")
    # The server keeps the last upload of each scene; rsync sends only the parts that changed against it
    # (textures, meshes and packed files mostly match) and the job gets a hard link to the result.
    cached = f"{REMOTE_ROOT}/cache/{cache_key(path)}.blend"
    ssh(f"mkdir -p {rdir}/frames {rdir}/logs {REMOTE_ROOT}/cache")
    print(f"uploading to {HOST}:{rdir} (diff against the last upload) ...")
    r = subprocess.run(["rsync", "-az", "--no-whole-file", "--stats", "-e", "ssh " + " ".join(SSH_OPTS), packed,
                        f"{HOST}:{cached.replace('~/', '')}"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("upload failed: " + r.stderr.strip())
    stat = {k.strip(): v.split()[0].replace(",", "") for k, _, v in
            (l.partition(":") for l in r.stdout.splitlines() if ":" in l) if v.strip()}
    sent = int(stat.get("Total bytes sent", 0)) / 1e6
    matched = int(stat.get("Matched data", 0)) / 1e6
    print(f"  sent {sent:.1f} MB of {size:.0f} MB" + (f" ({matched:.0f} MB already on the server)" if matched else " (first upload)"))
    ssh(f"ln -f {cached} {rdir}/scene.blend")

    w = max(1, a.workers)
    lines = ["#!/bin/bash", f"cd {rdir}", ": > pids"]
    with open(os.path.join(work, "device.py"), "w") as f:
        f.write(REMOTE_DEVICE_PY)
    subprocess.run(["rsync", "-a", "-e", "ssh " + " ".join(SSH_OPTS), os.path.join(work, "device.py"),
                    f"{HOST}:{rdir.replace('~/', '')}/device.py"], check=True)
    for k in range(min(w, len(frames))):      # staggered starts so their first placeholder claims don't collide
        lines.append(f"{REMOTE_BLENDER} -b scene.blend -P device.py -s {start} -e {end} -j {step} -a "
                     f"> logs/w{k + 1}.log 2>&1 & echo $! >> pids; sleep 2")
    lines.append("wait")
    if a.video_only:                          # encode on the server; only the video comes back
        digits = 4
        lines.append(f"ffmpeg -y -loglevel error -framerate {info['fps']} -start_number {start} "
                     f"-i frames/f_%0{digits}d{info['ext']} -c:v libx264 -crf 18 -pix_fmt yuv420p "
                     f"-movflags +faststart video.mp4 > logs/ffmpeg.log 2>&1")
    lines.append("date +%s > done")
    script = "\n".join(lines) + "\n"
    ssh(f"cat > {rdir}/run.sh <<'RTXEOF'\n{script}RTXEOF\nchmod +x {rdir}/run.sh; date +%s > {rdir}/started")
    # The detached launch can keep the ssh session open (it sometimes never returns), so fire it with a
    # timeout and then confirm the workers really started.
    try:
        subprocess.run(["ssh", "-o", "ControlPath=none", "-o", "BatchMode=yes", HOST,
                        f"cd {rdir} && (setsid nohup ./run.sh > logs/run.log 2>&1 < /dev/null &)"],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=20)
    except subprocess.TimeoutExpired:
        pass
    time.sleep(3)
    if not ssh(f"cat {rdir}/pids 2>/dev/null").strip():
        sys.exit(f"workers did not start; see ssh {HOST} 'cat {rdir}/logs/run.log'")

    st = load_state()
    st[job] = dict(job=job, host=HOST, rdir=rdir, out=out, total=len(frames), ext=info["ext"],
                   fps=info["fps"], workers=w, created=time.time(), source=path, video_only=a.video_only)
    save_state(st)
    os.makedirs(out, exist_ok=True)
    print(f"job {job} started with {w} workers -> " +
          (f"video lands in {out}.mp4" if a.video_only else f"frames land in {out}"))
    if a.detach:
        print(f"monitor with: rtx-render monitor {job}")
        return
    monitor_job(st[job], mp4=a.mp4)


# ------------------------------------------------------------------ monitor
def poll(j):
    """One ssh round trip: frames done, finished?, GPU, last progress line per worker."""
    rdir = j["rdir"]
    cmd = (f"cd {rdir} 2>/dev/null || exit 3; "
           f"echo FRAMES $(find frames -type f -size +0 | wc -l); echo STARTED $(cat started 2>/dev/null); "
           f"echo DONE $(cat done 2>/dev/null); "
           f"echo GPU $(nvidia-smi --query-gpu=utilization.gpu,memory.used --format=csv,noheader,nounits | head -1); "
           f"for l in logs/w*.log; do echo \"LOG $(basename $l .log) $(tail -c 400 $l | tr '\\r' '\\n' | grep -E 'Fra:|Error' | tail -1)\"; done")
    r = subprocess.run(["ssh", *SSH_OPTS, HOST, cmd], capture_output=True, text=True)
    if r.returncode == 3:
        return None
    out = dict(frames=0, started=None, done=None, gpu="?", logs=[])
    for line in r.stdout.splitlines():
        key, _, rest = line.partition(" ")
        if key == "FRAMES":
            out["frames"] = int(rest or 0)
        elif key == "STARTED" and rest.strip():
            out["started"] = int(rest)
        elif key == "DONE" and rest.strip():
            out["done"] = int(rest) if rest.strip().isdigit() else int(time.time())
        elif key == "GPU":
            out["gpu"] = rest.strip()
        elif key == "LOG":
            out["logs"].append(rest.strip())
    return out


def sync(j, settle=True):
    """Copy finished frames into the out folder (skips files still being written)."""
    rdir = j["rdir"].replace("~/", "")
    flt = ["--exclude", "*.tmp"]
    if settle:   # only files untouched for 3 s, so a half-written PNG never lands locally
        listing = subprocess.run(["ssh", *SSH_OPTS, HOST,
                                  f"cd {j['rdir']}/frames && find . -type f -size +0 -not -newermt '-3 seconds' -printf '%P\\n'"],
                                 capture_output=True, text=True).stdout
        have = set(os.listdir(j["out"])) if os.path.isdir(j["out"]) else set()
        todo = [f for f in listing.split() if f not in have]
        if not todo:
            return 0
        with tempfile.NamedTemporaryFile("w", delete=False) as f:
            f.write("\n".join(todo))
        flt = ["--files-from", f.name]
    os.makedirs(j["out"], exist_ok=True)
    subprocess.run(["rsync", "-a", *flt, "-e", "ssh " + " ".join(SSH_OPTS),
                    f"{HOST}:{rdir}/frames/", j["out"] + "/"], capture_output=True)
    if settle:
        os.unlink(flt[1])
    return 1


def encode(j):
    frames = sorted(f for f in os.listdir(j["out"]) if f.endswith(j["ext"]))
    if not frames:
        return
    stem = frames[0][:-len(j["ext"])]
    prefix = stem.rstrip("0123456789")
    digits = len(stem) - len(prefix)
    start = int(stem[len(prefix):])
    mp4 = j["out"].rstrip("/") + ".mp4"
    src = ["ffmpeg", "-y", "-loglevel", "error", "-framerate", str(j["fps"]), "-start_number", str(start),
           "-i", os.path.join(j["out"], f"{prefix}%0{digits}d{j['ext']}")]
    env = {k: v for k, v in os.environ.items() if k != "CUDA_VISIBLE_DEVICES"}   # an empty one hides NVENC
    for codec in (["-c:v", "libx264", "-crf", "18"], ["-c:v", "h264_nvenc", "-preset", "p7", "-cq", "19"]):
        if subprocess.run(src + codec + ["-pix_fmt", "yuv420p", "-movflags", "+faststart", mp4], env=env,
                          capture_output=True).returncode == 0:
            print(f"encoded {mp4}")
            return
    print("mp4 encoding failed (no libx264 or h264_nvenc); the frames are all there")


def monitor_job(j, mp4=False):
    print(f"monitoring {j['job']} via {HOST} (Ctrl-C detaches; the render keeps going)")
    t_seen, n_seen = time.time(), 0
    try:
        while True:
            p = poll(j)
            if p is None:
                sys.exit("job directory is gone on the server")
            video = j.get("video_only")
            if not video:
                sync(j)
            n = p["frames"]
            if n != n_seen:
                t_seen, n_seen = time.time(), n
            el = time.time() - p["started"] if p["started"] else 0
            rate = n / el if el > 0 and n else 0
            eta = (j["total"] - n) / rate if rate else 0
            bar = "#" * int(30 * n / j["total"]) + "." * (30 - int(30 * n / j["total"]))
            gpu = p["gpu"].split(",")
            gpu_s = f"GPU {gpu[0].strip()}% {int(gpu[1]) / 1024:.1f} GB" if len(gpu) == 2 else "GPU ?"
            local = "-" if video else len([f for f in os.listdir(j["out"]) if f.endswith(j["ext"])])
            sys.stdout.write("\x1b[2K\r" + f"[{bar}] {n}/{j['total']}  local {local}  "
                             f"{rate * 60:.1f} f/min  elapsed {fmt_time(el)}  ETA {fmt_time(eta)}  {gpu_s}")
            sys.stdout.flush()
            harmless = ("strokes set empty", "Not freed memory blocks")
            errors = [l for l in p["logs"] if "Error" in l and not any(h in l for h in harmless)]
            if errors:
                print("\n  " + "\n  ".join(errors))
            if p["done"] and video:
                mp4_path = j["out"].rstrip("/") + ".mp4"
                subprocess.run(["rsync", "-a", "-e", "ssh " + " ".join(SSH_OPTS),
                                f"{HOST}:{j['rdir'].replace('~/', '')}/video.mp4", mp4_path], capture_output=True)
                print(f"\nfinished: {n}/{j['total']} frames in {fmt_time(p['done'] - p['started'])}; " +
                      (f"video in {mp4_path}" if os.path.exists(mp4_path) else
                       f"no video - see ssh {HOST} 'cat {j['rdir']}/logs/ffmpeg.log'"))
                return
            if p["done"]:
                sync(j, settle=False)
                local = len([f for f in os.listdir(j["out"]) if f.endswith(j["ext"])])
                print(f"\nfinished: {n}/{j['total']} frames in {fmt_time(p['done'] - p['started'])}, "
                      f"{local} in {j['out']}")
                if n < j["total"]:
                    print(f"  some frames are missing; worker logs: ssh {HOST} 'tail {j['rdir']}/logs/*.log'")
                if mp4:
                    encode(j)
                return
            if time.time() - t_seen > 900:
                print(f"\n  no new frame for 15 min - check: ssh {HOST} 'tail {j['rdir']}/logs/*.log'")
                t_seen = time.time()
            time.sleep(8)
    except KeyboardInterrupt:
        print(f"\ndetached; rtx-render monitor {j['job']} to reattach")


# ------------------------------------------------------------------ other commands
def status(_):
    st = load_state()
    if not st:
        print("no jobs")
    for j in sorted(st.values(), key=lambda j: j["created"]):
        p = poll(j)
        state = "gone" if p is None else ("done" if p["done"] else "running")
        n = p["frames"] if p else 0
        print(f"{j['job']:40s} {state:8s} {n:>5}/{j['total']:<5} -> {j['out']}")


def cancel(a):
    j = pick_job(load_state(), a.job)
    # kill by recorded pid only (pgrep can hang on that box); the wrapper exits once its children do
    ssh(f"cd {j['rdir']} && for p in $(cat pids 2>/dev/null); do kill $p 2>/dev/null; done; date +%s > done; echo ok")
    print(f"cancelled {j['job']}; frames so far stay in {j['out']} after the next sync")
    sync(j, settle=False)


def clean(a):
    st = load_state()
    if a.cache:
        print(ssh(f"du -sh {REMOTE_ROOT}/cache 2>/dev/null; rm -rf {REMOTE_ROOT}/cache").strip() + "  removed")
        return
    j = pick_job(st, a.job)
    p = poll(j)
    if p and not p["done"]:
        sys.exit("job still running; cancel it first")
    ssh(f"rm -rf {j['rdir']}")
    del st[j["job"]]
    save_state(st)
    print(f"removed {j['rdir']} from {HOST} (local frames in {j['out']} kept)")


def main():
    global HOST
    if any(h in sys.argv[1:] for h in ("-h", "--help")):
        HOST = "rtxserver"
    else:
        HOST = resolve_host()
    cmds = {"monitor", "status", "cancel", "clean"}
    if len(sys.argv) > 1 and sys.argv[1] in cmds:
        ap = argparse.ArgumentParser(prog="rtx-render " + sys.argv[1])
        if sys.argv[1] != "status":
            ap.add_argument("job", nargs="?")
        if sys.argv[1] == "monitor":
            ap.add_argument("--mp4", action="store_true", help="encode out/<name>.mp4 when done")
        if sys.argv[1] == "clean":
            ap.add_argument("--cache", action="store_true", help="drop the cached scene uploads instead")
        a = ap.parse_args(sys.argv[2:])
        if sys.argv[1] == "monitor":
            monitor_job(pick_job(load_state(), a.job), mp4=a.mp4)
        else:
            {"status": status, "cancel": cancel, "clean": clean}[sys.argv[1]](a)
        return
    ap = argparse.ArgumentParser(prog="rtx-render", description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1])
    ap.add_argument("scene", help=".blend file, or a .py that builds the scene")
    ap.add_argument("-o", "--out", help="local folder for the frames (default ./out/<name>)")
    ap.add_argument("-s", "--start", type=int)
    ap.add_argument("-e", "--end", type=int)
    ap.add_argument("-w", "--workers", type=int, default=1,
                    help="parallel Blender processes on the server (default 1: the GPU is shared; more workers "
                         "help when CPU-side work like Freestyle dominates - check nvidia-smi first)")
    ap.add_argument("--base", help="for a .py: .blend to open before running it")
    ap.add_argument("--mp4", action="store_true", help="encode out/<name>.mp4 when done")
    ap.add_argument("--detach", action="store_true", help="start it and return; use monitor later")
    ap.add_argument("--video-only", action="store_true",
                    help="encode the mp4 on the server and download only that (for slow links / off campus)")
    submit(ap.parse_args())


if __name__ == "__main__":
    main()
